<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Yesil.ViewModels"
             x:Class="Yesil.Views.CommunityView"
             x:DataType="viewmodels:CommunityViewModel"
             Title="Topluluk">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Topluluk tavsiyeleri" FontSize="22" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Girdiler}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="18" Padding="16" Margin="0,6" HasShadow="True">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Baslik}" FontAttributes="Bold" />
                                <Label Text="{Binding Icerik}" />
                                <Label Text="Kullanıcı: {Binding KullaniciAdi}" FontAttributes="Italic" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Begeni, StringFormat='{0} beğeni'}" />
                                    <Label Text="{Binding UzmanOnayli, StringFormat='Uzman onaylı: {0}'}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
