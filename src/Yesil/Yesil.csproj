<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Yesil</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>yesil</ApplicationTitle>
    <ApplicationId>com.yesil.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>

  <ItemGroup>
    <MauiXaml Include="App.xaml" />
    <MauiXaml Include="AppShell.xaml" />
    <MauiXaml Include="Views\**\*.xaml" />
    <MauiXaml Include="Components\**\*.xaml" />
    <MauiXaml Include="Resources\Styles\*.xaml" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <ApplicationDefinition Include="Platforms\Windows\App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\**" />
    <MauiImage Include="Resources\Images\**" />
    <MauiFont Include="Resources\Fonts\**" />
    <MauiAsset Include="Resources\Raw\**" />
  </ItemGroup>
</Project>
