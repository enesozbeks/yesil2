<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Yesil.Components.ProgressCard">
    <Frame CornerRadius="18" Padding="16" BackgroundColor="White" HasShadow="True">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <Label Text="{Binding Baslik}" FontSize="18" Grid.ColumnSpan="2" />
            <Label Text="{Binding AltBaslik}" Grid.Row="1" />
            <Border Grid.Row="1" Grid.Column="1" Padding="6,2" BackgroundColor="{Binding RozetRenk}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding RozetMetni}" TextColor="White" />
            </Border>
        </Grid>
    </Frame>
</ContentView>
